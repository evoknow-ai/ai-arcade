{
  "manifest_version": 3,
  "name": "AI Arcade by EVOKNOW",
  "short_name": "AI Arcade",
  "version": "0.1.0",
  "description": "A store of classic arcade games with AI opponents and a shared global leaderboard.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open AI Arcade" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://eatsleepai.us/*"],
  "options_page": "store/store.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
