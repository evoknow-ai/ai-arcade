# Add this location block to the existing eatsleepai.us server {} that fronts Ghost.
# Ghost keeps the rest of the site; only /arcade/api/* goes to arcade-server.
location /arcade/api/ {
    proxy_pass http://127.0.0.1:8080/api/;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $host;
}
